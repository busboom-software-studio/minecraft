{
	"schemaVersion": 1,
	"id": "nolanmod",
	"version": "${version}",
	"name": "Nolan's Mod",
	"description": "Nolan's custom Minecraft mod.",
	"authors": [
		"Nolan",
		"Eric Busboom"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/nolanmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.nolan.nolanmod.NolanMod",
			"com.nolan.nolanmod.plane.PlaneMod",
			"com.nolan.nolanmod.daytime.DayTimeMod",
			"com.nolan.nolanmod.mech.MechMod",
			"com.nolan.nolanmod.robot.RobotMod"
		],
		"client": [
			"com.nolan.nolanmod.client.NolanModClient",
			"com.nolan.nolanmod.client.plane.PlaneClient",
			"com.nolan.nolanmod.client.clicks.ClickModeClient",
			"com.nolan.nolanmod.client.mech.MechClient",
			"com.nolan.nolanmod.client.robot.RobotClient"
		]
	},
	"mixins": [
		"nolanmod.mixins.json",
		{
			"config": "nolanmod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
